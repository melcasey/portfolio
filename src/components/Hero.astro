---
type HeadlinePart =
  | { type: 'word'; text: string; canva?: boolean }
  | { type: 'highlight'; text: string };

const headlineParts: HeadlinePart[] = [
  { type: 'word', text: 'Product' },
  { type: 'word', text: 'Designer' },
  { type: 'word', text: 'in' },
  { type: 'word', text: 'Melbourne,' },
  { type: 'word', text: 'crafting' },
  { type: 'highlight', text: 'delightful experiences' },
  { type: 'word', text: 'that' },
  { type: 'word', text: 'solve' },
  { type: 'highlight', text: 'real problems' },
  { type: 'word', text: '\u2014 most' },
  { type: 'word', text: 'recently' },
  { type: 'word', text: 'at' },
  { type: 'word', text: 'Canva', canva: true },
];
---

<section class="hero container" aria-label="Introduction">
  <h1 class="hero__headline">
    {
      headlineParts.map((part, index) => {
        const wordIndex = index;

        if (part.type === 'highlight') {
          return (
            <>
              {index > 0 && ' '}
              <span
                class="hero__highlight-group"
                style={`--word-i: ${wordIndex}`}
              >
                <span class="hero__word">{part.text}</span>
                <span class="hero__highlight-bar" aria-hidden="true"></span>
              </span>
            </>
          );
        }

        if (part.canva) {
          return (
            <>
              {index > 0 && ' '}
              <span class="hero__word" style={`--word-i: ${wordIndex}`}>
                <a
                  class="hero__canva"
                  data-canva-confetti
                  href="https://www.canva.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <em>Canva</em></a>{'.'}
              </span>
            </>
          );
        }

        return (
          <>
            {index > 0 && ' '}
            <span class="hero__word" style={`--word-i: ${wordIndex}`}>
              {part.text}
            </span>
          </>
        );
      })
    }
  </h1>
</section>
