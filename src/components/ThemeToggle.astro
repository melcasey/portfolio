<button
  type="button"
  class="header__link theme-toggle"
  data-theme-toggle
  aria-label="Switch theme"
  aria-pressed="true"
>
  <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">☀️</span>
  <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true" hidden>🌙</span>
</button>
